{
  "compilerOptions": {
    "allowJs": false,
    "jsx": "react",
    "target": "es2017",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "lib": ["es2017", "dom"],
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "lib",
    "baseUrl": ".",
    "typeRoots": ["./types/", "./node_modules/@types"],
    "paths": {
      "mailspring-exports": ["../Mailspring/app/src/global/mailspring-exports"],
      "mailspring-component-kit": ["../Mailspring/app/src/global/mailspring-component-kit"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
  ],
  "exclude": ["node_modules", "lib"]
}
